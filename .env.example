# RemiCare Cover Test Backend Environment Configuration

# Server & Origins
APP_ENV=production
REMICARE_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.vercel.app
MODEL_PATH=models/korean_shared_model.joblib

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Supabase)
# -----------------------------------------------------------------------------
# CRITICAL NOTICE FOR RENDER DEPLOYMENT:
# DO NOT use Supabase Direct Connection (db.[PROJECT_REF].supabase.co:5432).
# Direct hostnames are IPv6-only, while Render Web Services do NOT support outbound IPv6.
# Using direct connection will result in: OSError: [Errno 101] Network is unreachable.
#
# ALWAYS use Supabase Supavisor Connection Pooler (supports IPv4):
# Option A (Recommended for Render): Transaction Pooler (Port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Option B: Session Pooler (Port 5432)
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Database Pool Tuning (Prevents Supabase idle disconnects)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Keep-Alive & Self-Ping Configuration (Prevents Render 15-min idle spin-down)
# -----------------------------------------------------------------------------
# Render automatically injects RENDER_EXTERNAL_URL in production (e.g. https://remicare-strabismus-ai.onrender.com)
RENDER_EXTERNAL_URL=https://remicare-strabismus-ai.onrender.com
SELF_PING_URL=
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_SECONDS=600
KEEP_ALIVE_PING_DB=true

# -----------------------------------------------------------------------------
# Supabase Storage Configuration (Server-side Service Role only - NEVER expose to frontend)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_STORAGE_BUCKET_RAW=cover-test-raw
ENABLE_AI_INFERENCE_ON_SAVE=true

