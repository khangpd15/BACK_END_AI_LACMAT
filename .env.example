# RemiCare Strabismus AI Backend - Environment Variables
APP_ENV=production
MAX_IMAGE_SIZE=10485760

# Frontend CORS
FRONTEND_URL=
REMICARE_FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# Database & Supabase (PostgreSQL pooler port 6543 or direct 5432)
DATABASE_URL=postgresql+asyncpg://postgres.your-ref:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Keep-Alive & Self-Ping
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_SECONDS=600
RENDER_EXTERNAL_URL=

# Bounded CPU inference (one Uvicorn worker)
HIRSCHBERG_CPU_THREADS=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
# Local session files on Render are ephemeral; configure DATABASE_URL for retention.
