# RemiCare Strabismus AI Backend - Environment Variables
APP_ENV=production
MAX_IMAGE_SIZE=10485760

# Frontend CORS
FRONTEND_URL=
REMICARE_FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000


# Keep-Alive & Self-Ping
KEEP_ALIVE_ENABLED=false
KEEP_ALIVE_INTERVAL_SECONDS=600
RENDER_EXTERNAL_URL=

# Bounded CPU inference (one Uvicorn worker)
HIRSCHBERG_CPU_THREADS=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1

# Session metadata/results use data/hirschberg/sessions only.
# Render ephemeral storage can lose local sessions after redeploy.
