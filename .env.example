# RemiCare Cover Test Backend Environment Configuration

# Server & Origins
ENVIRONMENT=development
REMICARE_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_PATH=models/korean_shared_model.joblib

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres

# Supabase Storage Configuration (Server-side Service Role only - NEVER expose to frontend)
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_STORAGE_BUCKET_RAW=cover-test-raw
ENABLE_AI_INFERENCE_ON_SAVE=true
